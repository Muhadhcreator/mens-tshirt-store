<!DOCTYPE html>
<html>
<head>
  <title>Men T-Shirt Store</title>

  <style>

    body{
      background:#111;
      color:white;
      font-family:Arial;
      margin:0;
      padding:0;
    }

    .header{
      background:black;
      padding:20px;
      text-align:center;
      font-size:28px;
      font-weight:bold;
    }

    .container{
      display:flex;
      flex-wrap:wrap;
      justify-content:center;
      gap:20px;
      padding:20px;
    }

    .card{
      background:#1e1e1e;
      width:250px;
      border-radius:15px;
      overflow:hidden;
      box-shadow:0 0 10px rgba(255,255,255,0.2);
    }

    .card img{
      width:100%;
    }

    .card-content{
      padding:15px;
    }

    .price{
      color:lime;
      font-size:20px;
      margin:10px 0;
    }

    button{
      width:100%;
      padding:12px;
      border:none;
      background:red;
      color:white;
      font-size:16px;
      border-radius:10px;
    }

  </style>
</head>

<body>

<div class="header">
  MEN T-SHIRT STORE
</div>

<div class="container">

  <div class="card">

    <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab">

    <div class="card-content">

      <h2>Black T-Shirt</h2>

      <div class="price">
        Rs 4500
      </div>

      <button onclick="orderNow()">
        Order Now
      </button>

    </div>

  </div>

</div>

<script>

function orderNow(){

  window.open(
  "https://wa.me/94700000000?text=I want this T-Shirt"
  );

}

</script>

</body>
</html>